#include <stdio.h>

    /*Faça um programa em C que receba um valor inteiro qualquer
e mostre o quociente da divisão desse valor por 3*/
int main() {
    int n, d;
    printf("Digite um numero: ");
    scanf("%d", &n);
    d = n / 3;
    printf("O numero digitado é:%d, e vai ser dividido por 3\n %d / 3 = %d", n, n, d);
    return 0;
}
