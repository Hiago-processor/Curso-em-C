#include <stdio.h>
int main(){
/*Faça um programa em C para determinar a área de um
triângulo.

Fórmula/Processamento: Área = base x altura /2*/
int base, altura, area;
printf("Bem-Vindo ao sistema de Area de triangulo!\n");
printf("Quanto é a base: ");
scanf("%d", &base);
printf("Quanto é a altura: ");
scanf("%d", &altura);

//Se quiser colocar um / pode colocar, mas isso é só para resltados mais precisos.
area = base * altura;

printf("A área é: %dcm²", area);


return 0;
    
}
